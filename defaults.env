# --- Domain identity ---
# The image entrypoint uppercases REALM itself.
REALM=bytestorm.local
# NetBIOS (short) domain name.
WORKGROUP=BYTESTORM
# Short DC host name  ->  dc01.bytestorm.local
NETBIOS_NAME=DC01
# Full DC FQDN (compose can't do bash lowercase, so set it explicitly).
DC_FQDN=dc01.bytestorm.local
# Samba process model.
MODEL=standard

# --- Samba interface binding ---
INTERFACES="lo tun0"
BIND_INTERFACES_ONLY=no

# --- DNS forwarder ---
DNS_FORWARDER=1.1.1.1

# Name of the docker secret holding the Administrator password.
ADMIN_PASSWORD_SECRET=samba-admin-password
ADMIN_PASS=Password__42
TRUST_SECRET=Password__42

# --- Deterministic identity across container rebuilds ---
# Comment out to randomize
DOMAIN_SID=S-1-5-21-42-42-42
MACHINE_PASS=Password__42

TZ=UTC
