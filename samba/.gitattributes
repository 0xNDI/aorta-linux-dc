# Normalize line endings to LF for all text files.
# This repo lives on a VMware share mounted from Windows, so enforce LF
# both in the object database and in the working tree on every platform.
* text=auto eol=lf

# Explicit text (forces LF even if auto-detection is unsure)
*.py   text eol=lf
*.xml  text eol=lf
*.md   text eol=lf
*.toml text eol=lf
*.cfg  text eol=lf
*.ini  text eol=lf
*.json text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.txt  text eol=lf
*.sh   text eol=lf

# Binary assets — never touch line endings
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.zip  binary
*.gz   binary
